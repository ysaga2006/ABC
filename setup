#!/bin/bash
# ライブコンテスト用セットアップスクリプト
# accと同じフォルダ構造を手動で作成します
#
# 使い方:
#   ./setup abc999         # a〜gの7問分を作成
#   ./setup arc999         # a〜fの6問分を作成
#   ./setup abc999 d e     # d, e問題だけ追加

usage() {
    echo "使い方: ./setup <contest_id> [problems]"
    echo "例:     ./setup abc999"
    echo "        ./setup arc999"
    echo "        ./setup abc999 d"
}

CONTEST=${1:-}

if [ -z "$CONTEST" ]; then
    usage
    return 1 2>/dev/null || exit 1
fi

shift
CONTEST=$(echo "$CONTEST" | tr '[:upper:]' '[:lower:]')
PREFIX=$(echo "$CONTEST" | sed 's/[0-9]*$//')
NUM=$(echo "$CONTEST" | grep -o '[0-9]*$')

if [ -z "$PREFIX" ] || [ -z "$NUM" ]; then
    echo "Error: contest_id は abc999 / arc999 の形式で指定してください"
    return 1 2>/dev/null || exit 1
fi

if [ $# -gt 0 ]; then
    FIRST_PROBLEM=$1
else
    case "$PREFIX" in
        abc) set -- a b c d e f g ;;
        arc) set -- a b c d e f ;;
        *) set -- a b c d e f ;;
    esac
    FIRST_PROBLEM=$1
fi
TEMPLATE="$HOME/Library/Preferences/atcoder-cli-nodejs/cpp/main.cpp"

if [ ! -f "$TEMPLATE" ]; then
    echo "Error: テンプレートファイルが見つかりません: $TEMPLATE"
    return 1 2>/dev/null || exit 1
fi

# コンテストが入る百の位フォルダを特定 (abc4xx, abc3xx, etc.)
HUNDREDS="${PREFIX}${NUM:0:1}xx"

mkdir -p "$HUNDREDS/$CONTEST"

for p in "$@"; do
    DIR="$HUNDREDS/$CONTEST/$p"
    mkdir -p "$DIR"
    if [ ! -f "$DIR/main.cpp" ]; then
        cp "$TEMPLATE" "$DIR/main.cpp"
        echo "  ✓ $DIR/main.cpp"
    else
        echo "  - $DIR/main.cpp (already exists)"
    fi
    if [ ! -f "$DIR/input.txt" ]; then
        touch "$DIR/input.txt"
        echo "  ✓ $DIR/input.txt"
    fi
done

echo ""
echo " $CONTEST のセットアップ完了！"
echo " 場所: $HUNDREDS/$CONTEST/"

TARGET_DIR="$HUNDREDS/$CONTEST/$FIRST_PROBLEM"
CD_COMMAND="cd $TARGET_DIR"

if command -v pbcopy >/dev/null 2>&1 && printf "%s" "$CD_COMMAND" | pbcopy; then
    echo " コピー済み: $CD_COMMAND"
else
    echo " 移動するなら: $CD_COMMAND"
fi
